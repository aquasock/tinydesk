# Your own board wiring: never in git (see board.example.conf).
# Only the board.example.conf files are shared.
board.conf
!board.example.conf

# Build output
build/
build-*/
ports/*/build/
dist/

# ESP-IDF: per-machine configuration and downloaded components
# (sdkconfig is regenerated from sdkconfig.defaults).
ports/*/sdkconfig
ports/*/sdkconfig.old
ports/*/managed_components/
*.log

# Firmware images
*.bin
*.elf
*.map

# Host desktop run-time data
tinydesk_fs/
tinydesk_settings.bin

# Local leftovers
local-review/
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store
Thumbs.db

# WiFi credentials written by `wifi` at runtime live in /fs/etc/wifi.conf on
# the device, not here. Never commit a local copy.
ports/*/wifi.conf
wifi.conf

# Bench state, generated on first run
tools/host-config/storage/
tools/host-config/rnsd.log

# Generated by the build into build/; a copy in the source tree is a mistake
ports/*/board_builtin.conf
