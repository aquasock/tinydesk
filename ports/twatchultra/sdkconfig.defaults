# tinydesk on the LilyGo T-Watch Ultra (ESP32-S3, 16 MB flash, 8 MB QUAD
# PSRAM), ESP-IDF 5.3.1.

# --- Target ---------------------------------------------------------------
CONFIG_IDF_TARGET_ESP32S3=y

# --- The USB Serial/JTAG port belongs to tinydesk alone -------------------
# There is no USB-UART bridge chip: USB-C is the ESP32-S3's own USB
# Serial/JTAG peripheral (GPIO19/20), which is where the keyboard arrives and
# where the picture is mirrored. The ESP-IDF console is off; logs go to the
# Log Viewer. UART0 is left free.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Quiet boot: the ROM's USB output is detached in app_main() and the desktop
# redraws the whole screen on start.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

CONFIG_FREERTOS_HZ=1000

# --- Flash and PSRAM ------------------------------------------------------
# 16 MB QSPI flash (DIO at 80 MHz, as fitted).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# QUAD PSRAM, AND THIS IS THE ONE SETTING THAT MATTERS.
#
# The ESP32-S3 in this watch has QUAD PSRAM, not octal, while ESP-IDF's
# default for the S3 is also quad -- so the trap here is the opposite of the
# CrowPanel's: copying an OCT target's config stops the board at boot with
#     E octal_psram: PSRAM ID read error: 0x00000000
# and nothing else, because the abort happens before anything can report it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Static buffers of tinydesk and TinyDesk Shell go to PSRAM (main/extram.lf).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- TinyDesk Shell settings ----------------------------------------------
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_VFS_SUPPORT_DIR=y
# Board wiring (I2C for the touch panel, display pins) is not configured here:
# see board.example.conf.

# --- Firmware updates (OTA) and TLS ---------------------------------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Memory protection off, so TinyDesk Shell's py can run native code from
# internal RAM.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n

# Task Manager: task list and CPU shares.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# FreeRTOS kernel code (non-ISR functions) in flash, which frees IRAM for the
# QSPI panel driver and the rest of the firmware.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# --- Bluetooth LE keyboards and mice --------------------------------------
# bt_hid.c (bt.enable = 1, set in board.example.conf) is the watch's input:
# the panel is 320x400 of glass, which is too small to type on, so there is no
# on-screen keyboard here and a Bluetooth keyboard and mouse do the work.
# NimBLE as a central only -- it connects to devices, it never advertises --
# with the same limits as ports/nanoesp32.
#
# The radio needs the memory the settings below put in PSRAM; a build without
# CONFIG_BT_ENABLED still compiles (bt_hid.c has an empty stub) and simply
# reports no Bluetooth, which is how this port shipped until now -- the
# keyboard and mouse could not have worked.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_MAX_BONDS=6
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Its memory from PSRAM, which this board has 8 MB of.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Coexistence with Wi-Fi, which is how the desktop reaches telnet and OTA.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- Wi-Fi buffers: internal DRAM is the scarce memory ---------------------
# The ESP32-S3's Wi-Fi driver takes its receive and transmit buffers from
# INTERNAL DMA-capable RAM, never PSRAM, and it takes them at esp_wifi_init()
# whether or not a network is later joined. Each buffer is 1600 bytes, so the
# IDF default pair (16 static RX + 16 static TX) holds 51,200 bytes of internal
# DRAM for as long as the firmware runs -- against a heap that otherwise has
# roughly 72 KB free at idle and once dipped to 35 KB, which is below the
# 65,536 bytes tdsh's SSH server demands before it will start.
#
# 8 + 8 static holds 25,600 bytes and is still comfortably more than a transfer
# needs: SFTP measures 17.2 KiB/s here, nowhere near what eight 1600-byte
# buffers sustain, and the dynamic pools below absorb bursts. RX_BA_WIN must
# stay at or under 2 x STATIC_RX_BUFFER_NUM, so it comes down with it.
#
# Measured, not assumed: see the log for the heap delta at both settings.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16

# --- FAT, for the SD card --------------------------------------------------
# Long file names and UTF-8, matching every other ESP-IDF port here. Without
# them the card mounts but every name is mangled to 8.3 and non-ASCII bytes
# come back wrong, which makes a file browser useless -- and it fails quietly,
# because the mount itself succeeds.
#
# THESE MUST LIVE HERE AND NOT JUST IN sdkconfig. sdkconfig is generated and
# gitignored, so a change made only there is lost on a clean checkout and the
# symptom returns with no diff to blame. Changing a default also requires
# deleting the existing sdkconfig: it is only consulted when one is built from
# scratch.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- Optimisation ----------------------------------------------------------
# -O2, NOT -Og. Every emulator number this port recorded for its first months
# was measured with CONFIG_COMPILER_OPTIMIZATION_DEBUG, which is ESP-IDF's
# default and is chosen to make a debugger useful rather than to make an
# emulator keep up. Nothing marked it as a decision, so it went unnoticed.
#
# Switching to -O2 on 2026-11-13 took the Pokemon Mini core from 81.6 to 117.9
# fps unpaced, cut emulation per frame from 13.5 to 9.6 ms, and raised the
# frame-budget headroom from 0.4 to 4.3 ms. The NES, which had been parked at 51
# fps, holds 60. The image is also 13 KB smaller.
#
# SAME RULE AS THE FAT SETTINGS ABOVE: this lives here, not only in sdkconfig,
# because sdkconfig is gitignored and a clean checkout would silently rebuild at
# -Og and lose all of it. An existing sdkconfig must be deleted for a change
# here to take effect.
#
# ONE COST, and it is why ports/twatchultra/CMakeLists.txt demotes
# -Werror=format-truncation: above -Og, GCC inlines far enough to see the
# destination size of two snprintf() calls in tdsh's prompt builders and fails
# the build on a truncation that cannot actually corrupt anything.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Caches ----------------------------------------------------------------
# 32 KB instruction cache, not the 16 KB default.
#
# The 6502 interpreter -- the single hottest function in the NES emulator -- is
# 21,175 bytes of code, and it runs in place from flash (IROM at 0x4211xxxx).
# With a 16 KB I-cache it cannot fit, so it evicted itself on every pass and the
# whole inner loop of the emulator ran at flash speed.
#
# MEASURED 2026-11-13, Zelda, interpreter only (`nes start <rom> noblit`):
#     16 KB   14,420 us/frame
#     32 KB   12,389 us/frame      -2,031 us, -14.1%
# and with the blitter running the frame went from ~16,000 to 13,557 us, taking
# the headroom against the 16,667 us budget from about 700 us to 3,110 us.
#
# It also made the blit cheaper (9,774 -> 8,069 us) because the row callback's
# own code is in flash too.
#
# COST: 16 KB of internal RAM. Free internal went 115,107 -> 90,503 bytes, still
# well clear of the 65,536 tdsh's SSH server refuses to start below. Growing the
# DATA cache to 64 KB was considered and rejected for exactly that reason: it
# would leave about 58 KB and stop SSH working.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_SIZE=0x8000

# --- Flash mode ------------------------------------------------------------
# Quad I/O, not the DIO default.
#
# The board's flash is a Winbond W25Q128JV (JEDEC EF 40 18), which is a quad
# part, so this is supported rather than hoped for. Note the ESPTOOLPY_FLASHMODE
# *string* stays "dio" even when this is set -- ESP-IDF flashes in DIO and the
# bootloader upgrades itself to quad during initialisation -- so reading the
# string back is not a way to check whether this took effect. Comparing
# bootloader.bin against a DIO build is.
#
# MEASURED 2026-11-13, Zelda, interpreter only (`nes start <rom> noblit`):
#     DIO   12,389 us/frame
#     QIO   12,122 us/frame      -267 us
# and with the blitter running, 13,557 -> 12,114 us/frame. That second gain is
# larger than the first and is the interesting part: at DIO the blit cost the
# interpreter about 1.2 ms of contention, and at QIO the two nearly stop
# interfering.
#
# COST: none in RAM. This is the only cache/bus lever that was free -- growing
# the data cache to 64 KB would have taken internal RAM below the 65,536 bytes
# tdsh's SSH server refuses to start below.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
